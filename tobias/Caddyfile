{
	# ZeroSSL is also a default issuer, the CAA record only allows Let's Encrypt.
	acme_ca https://acme-v02.api.letsencrypt.org/directory
	email {$ACME_EMAIL}
	metrics
	# Formats Caddy's own logs, each site below turns on access logging.
	log {
		format console
	}
}

# Split out because log is not an ordered handler and handle_errors only takes those.
(security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Referrer-Policy "no-referrer-when-downgrade"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

(headers) {
	log
	import security
	encode zstd gzip
}

(proxy) {
	import headers
	reverse_proxy {args[0]} {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-By {http.request.local}
		header_up CLIENT_IP {remote_host}
	}
}

rosenhof.chrissx.de {
	import headers
	root * /srv/dist/new/dist
	redir /merch /shop 301
	redir /dycc /discord 301
	redir /discord https://discord.gg/a2eAnvUscU 302
	redir /twitter https://twitter.com/chrissxMedia 302
	redir /instagram https://instagram.com/pixelcmtd 302
	metrics /metrics
	file_server browse
	# 404.html is built from src/pages/404.astro in new.chrissx.de.
	handle_errors {
		import security
		rewrite * /404.html
		file_server
	}
}

autoconfig.chrissx.de {
	import headers
	root * /srv/dist/new/dist/.well-known/autoconfig
	file_server
}

bucket.chrissx.de {
	import proxy bucket:8022
}

ferdium.chrissx.de {
	import proxy ferdium:3333
}

inv.chrissx.de {
	import proxy host.docker.internal:1339
}

ha.chrissx.de {
	import proxy host.docker.internal:8123
}

status-tobias.chrissx.de {
	import proxy kuma:3001
}
