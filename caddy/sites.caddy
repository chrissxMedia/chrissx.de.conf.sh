(main) {
	import headers
	root * /srv/dist/new/dist
	redir /merch /shop 301
	redir /dycc /discord 301
	redir /discord https://discord.gg/a2eAnvUscU 302
	redir /twitter https://twitter.com/chrissxMedia 302
	redir /instagram https://instagram.com/pixelcmtd 302
	metrics /metrics
	import not-found
}

(pixel) {
	import static pixel
	redir /twitter https://twitter.com/pixelcmtd 302
	redir /instagram https://instagram.com/pixelcmtd 302
}

(fonts) {
	import headers
	root * /srv/dist/fonts/dist
	header Access-Control-Allow-Origin "*"
	@css not path /fonts/*
	header @css Content-Type text/css
	header @css Cache-Control "max-age=3600"
	header /fonts/* Cache-Control "max-age=31536000"
	file_server {
		index index
	}
}

(autoconfig) {
	import headers
	root * /srv/dist/new/dist/.well-known/autoconfig
	file_server
}
