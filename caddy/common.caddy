{
	# ZeroSSL is also a default issuer, the CAA record only allows Let's Encrypt.
	acme_ca https://acme-v02.api.letsencrypt.org/directory
	email {$ACME_EMAIL}
	metrics
	# Formats Caddy's own logs, each site below turns on access logging.
	log {
		format console
	}
}

# Split out because log is not an ordered handler and handle_errors only takes those.
(security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Referrer-Policy "no-referrer-when-downgrade"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		-Server
	}
}

(headers) {
	log
	import security
	encode zstd gzip
}

(proxy) {
	import headers
	reverse_proxy {args[0]} {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-By {http.request.local}
		header_up CLIENT_IP {remote_host}
	}
}

(not-found) {
	# The shared 404 page is built by new.chrissx.de.
	handle_errors 404 {
		import security
		root * /srv/dist/new/dist
		rewrite * /404.html
		file_server
	}
}

(static) {
	import headers
	root * /srv/dist/{args[0]}/dist
	file_server
	import not-found
}
