# tobias example. On ruby, change SITE and any peer settings below.
SITE=tobias
KUMA_USERNAME=monitoring
KUMA_PASSWORD=

DISCORD_WEBHOOK=
# Optional Discord user mention, e.g. '<@123456789012345678>'.
DISCORD_MENTION=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TO=
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# Optional peer monitoring. Use docker-compose.peer.yaml to enable it.
# Generate two distinct tokens with `openssl rand -hex 16`.
# Each instance's OWN_PUSH_TOKEN is the other instance's PEER_PUSH_TOKEN.
# OWN_PUSH_TOKEN=
# PEER_PUSH_TOKEN=
# PEER_URL=https://status-ruby.chrissx.de
